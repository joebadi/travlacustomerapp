<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ requires a system splash. Use the transparent Travla mark
         instead of the masked adaptive launcher icon so it joins seamlessly
         to Flutter's first splash frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/travla_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/travla_splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/travla_launch_background</item>
        <item name="android:navigationBarColor">@color/travla_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/travla_launch_background</item>
        <item name="android:navigationBarColor">@color/travla_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
